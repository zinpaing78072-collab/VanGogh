<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.vangogh</groupId>
    <artifactId>van-gogh</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jooq.version>3.21.10</jooq.version>
        <sqlite.version>3.54.1.0</sqlite.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>build.krema</groupId>
            <artifactId>krema-core</artifactId>
            <version>0.3.2</version>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
        </dependency>
        <dependency>
            <groupId>io.vavr</groupId>
            <artifactId>vavr</artifactId>
            <version>1.0.1</version>
        </dependency>
        <!-- LLM transport: official OpenAI Java SDK. The base URL is overridden
             per request config, so any OpenAI-compatible endpoint (OpenRouter,
             local servers) works without a second client implementation. -->
        <dependency>
            <groupId>com.openai</groupId>
            <artifactId>openai-java</artifactId>
            <version>4.109.0</version>
        </dependency>
        <!-- JCEF experiment: Chromium Embedded Framework shell (swap for Krema system webview).
             Natives are downloaded automatically on first run (~100 MB per platform). -->
        <dependency>
            <groupId>me.friwi</groupId>
            <artifactId>jcefmaven</artifactId>
            <version>152.0.6</version>
        </dependency>
        <!-- Storage: jOOQ OSS supports SQLite since 3.19. The generated schema
             classes are produced from db/schema.sql at build time (see build). -->
        <dependency>
            <groupId>org.jooq</groupId>
            <artifactId>jooq</artifactId>
            <version>${jooq.version}</version>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.0</version>
            <scope>test</scope>
        </dependency>
        <!-- jOOQ logs through SLF4J; without a provider every test run prints a
             two-line warning. The NOP binding keeps test output clean. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <version>2.0.16</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>25</release>
                    <!-- Krema IPC binds @KremaCommand arguments by parameter name;
                         without this they arrive null with no error. -->
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <!-- Storage codegen, step 1: apply the committed DDL to a throwaway
                 SQLite database. Using real SQLite (not jOOQ's H2-backed
                 DDLDatabase) keeps the generated metadata exact: SQLite's
                 INTEGER PRIMARY KEY identity, partial indexes, and the quoted
                 "user" table all survive. This also fails the build when the
                 DDL is not valid SQLite. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>build-codegen-database</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <delete file="${project.build.directory}/codegen.db" quiet="true"/>
                                <sql driver="org.sqlite.JDBC"
                                     url="jdbc:sqlite:${project.build.directory}/codegen.db"
                                     userid="vangogh"
                                     password=""
                                     src="${project.basedir}/src/main/resources/db/schema.sql"
                                     autocommit="true"
                                     onerror="abort"
                                     print="false"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>org.xerial</groupId>
                        <artifactId>sqlite-jdbc</artifactId>
                        <version>${sqlite.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <!-- Storage codegen, step 2: reverse-engineer that SQLite database
                 into typed table/record classes under target/generated-sources.
                 Nothing generated is committed. -->
            <plugin>
                <groupId>org.jooq</groupId>
                <artifactId>jooq-codegen-maven</artifactId>
                <version>${jooq.version}</version>
                <executions>
                    <execution>
                        <id>generate-schema-classes</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>org.xerial</groupId>
                        <artifactId>sqlite-jdbc</artifactId>
                        <version>${sqlite.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <jdbc>
                        <driver>org.sqlite.JDBC</driver>
                        <url>jdbc:sqlite:${project.build.directory}/codegen.db</url>
                    </jdbc>
                    <generator>
                        <database>
                            <name>org.jooq.meta.sqlite.SQLiteDatabase</name>
                            <includes>.*</includes>
                            <excludes></excludes>
                        </database>
                        <target>
                            <packageName>vangogh.db</packageName>
                            <directory>${project.build.directory}/generated-sources/jooq</directory>
                        </target>
                    </generator>
                </configuration>
            </plugin>
            <!-- sqlite-jdbc loads a native library; Java 25 warns about restricted
                 native access without this flag. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
            <!-- Krema launcher. Run with JDK 25 (Maven may default to Temurin 21):
                 JAVA_HOME=/Library/Java/JavaVirtualMachines/jdk-25.jdk/Contents/Home
                     mvn compile exec:exec
                 exec:exec forks ${java.home}/bin/java so the pom JVM flags apply.
                 exec:java is the wrong tool on macOS — it reuses Maven's JVM and
                 drops the flags, so the window never appears. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <!-- ${java.home} is the JDK that Maven itself runs on -->
                    <executable>${java.home}/bin/java</executable>
                    <arguments>
                        <!-- Panama FFM: silence restricted-method warnings -->
                        <argument>--enable-native-access=ALL-UNNAMED</argument>
                        <!-- Heap cap: default max heap is 1/4 of RAM (~2 GB) on this
                             8 GB machine. RSS still includes WebKit. -->
                        <argument>-Xmx512m</argument>
                        <argument>-classpath</argument>
                        <classpath/>
                        <argument>vangogh.app.VanGoghApp</argument>
                    </arguments>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>macos</id>
            <activation>
                <os>
                    <family>mac</family>
                </os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.1.0</version>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <arguments>
                                <!-- macOS: libwebview.dylib drives NSApp (webview_run) on the
                                     calling thread, and AppKit only permits its event loop on
                                     the process's FIRST thread. Without this flag macOS kills
                                     the event loop ("nextEventMatchingMask should only be called
                                     from the Main Thread!") and no window appears. Mirrors
                                     krema-core's own pom. macOS-only HotSpot flag. -->
                                <argument>-XstartOnFirstThread</argument>
                                <argument>--enable-native-access=ALL-UNNAMED</argument>
                                <!-- JCEF macOS requirements (jcefmaven README): harmless for Krema too. -->
                                <argument>--add-opens=java.desktop/sun.awt=ALL-UNNAMED</argument>
                                <argument>--add-opens=java.desktop/sun.lwawt=ALL-UNNAMED</argument>
                                <argument>--add-opens=java.desktop/sun.lwawt.macosx=ALL-UNNAMED</argument>
                                <argument>-Xmx512m</argument>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>vangogh.app.VanGoghApp</argument>
                            </arguments>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- JCEF experiment shell. Run with: mvn exec:exec -Pjcef -->
        <profile>
            <id>jcef</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.1.0</version>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <arguments>
                                <!-- JVM flags per the jcefmaven README. Note: NO
                                     -XstartOnFirstThread — with it, main() runs on the
                                     AppKit-eligible first thread, and CEF's macOS native
                                     init (N_Initialize on the EDT) circular-waits with
                                     main blocked in invokeAndWait: nothing initializes and
                                     the AWT window never paints. jcefsampleapp launches as
                                     plain `java -jar` without the flag. (Krema's profile
                                     keeps it — the OS webview genuinely needs it.) -->
                                <!-- Panama FFM: silence restricted-method warnings. -->
                                <argument>--enable-native-access=ALL-UNNAMED</argument>
                                <!-- JCEF macOS requirements (jcefmaven README). -->
                                <argument>--add-opens=java.desktop/sun.awt=ALL-UNNAMED</argument>
                                <argument>--add-opens=java.desktop/sun.lwawt=ALL-UNNAMED</argument>
                                <argument>--add-opens=java.desktop/sun.lwawt.macosx=ALL-UNNAMED</argument>
                                <!-- OSR mode uses JOGL (jcefmaven README). -->
                                <argument>--add-exports=java.base/java.lang=ALL-UNNAMED</argument>
                                <argument>--add-exports=java.desktop/sun.awt=ALL-UNNAMED</argument>
                                <argument>--add-exports=java.desktop/sun.java2d=ALL-UNNAMED</argument>
                                <!-- Native fullscreen (title bar + menu bar hide):
                                     com.apple.eawt is internal on modern JDKs. -->
                                <argument>--add-exports=java.desktop/com.apple.eawt=ALL-UNNAMED</argument>
                                <!-- Heap cap. -->
                                <argument>-Xmx512m</argument>
                                <!-- No -Djava.library.path needed: CefInitializer appends the
                                     jcef-bundle install dir to it programmatically at startup. -->
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>vangogh.app.jcef.JcefVanGoghApp</argument>
                            </arguments>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>