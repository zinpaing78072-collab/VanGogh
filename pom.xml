<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.vangogh</groupId>
    <artifactId>van-gogh</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>25.0.5</javafx.version>
        <javafx.modules>javafx.controls,javafx.web</javafx.modules>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-web</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
        </dependency>
        <!-- PROTOTYPE (krema spike): system-webview shell. Throwaway; the JavaFX
             path above remains the shipping UI. 0.3.4 does not exist on Maven
             Central — stay on 0.3.2. -->
        <dependency>
            <groupId>build.krema</groupId>
            <artifactId>krema-core</artifactId>
            <version>0.3.2</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>25</release>
                    <!-- Krema IPC binds @KremaCommand arguments by parameter name;
                         without this they arrive null with no error. -->
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>vangogh.app.VanGoghApp</mainClass>
                    <options>
                        <option>--enable-native-access=javafx.graphics,javafx.web</option>
                    </options>
                </configuration>
            </plugin>
            <!-- PROTOTYPE (krema spike) launcher. Run with (JDK 25 required so
                 ${java.home} resolves to it — Maven itself may default to Temurin 21):
                 JAVA_HOME=/Library/Java/JavaVirtualMachines/jdk-25.jdk/Contents/Home mvn compile exec:exec
                 Arguments carried over verbatim from the working krema demo pom;
                 order matters. exec:java is the wrong tool on macOS — it reuses
                 Maven's JVM with none of these flags and the window never appears. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <!-- ${java.home} is the JDK that Maven itself runs on -->
                    <executable>${java.home}/bin/java</executable>
                    <arguments>
                        <!-- macOS: libwebview.dylib drives NSApp (webview_run) on the
                             calling thread, and AppKit only permits its event loop on
                             the process's FIRST thread. Without this flag macOS kills
                             the event loop ("nextEventMatchingMask should only be called
                             from the Main Thread!") and no window appears. Mirrors
                             krema-core's own pom. macOS-only HotSpot flag. -->
                        <argument>-XstartOnFirstThread</argument>
                        <!-- Panama FFM: silence restricted-method warnings -->
                        <argument>--enable-native-access=ALL-UNNAMED</argument>
                        <!-- Heap cap: default max heap is 1/4 of RAM (~2 GB) on this
                             8 GB machine. RSS still includes WebKit. -->
                        <argument>-Xmx512m</argument>
                        <argument>-classpath</argument>
                        <classpath/>
                        <argument>vangogh.spike.KremaShellSpike</argument>
                    </arguments>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>