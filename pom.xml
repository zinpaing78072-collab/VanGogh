<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.vangogh</groupId>
    <artifactId>van-gogh</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>build.krema</groupId>
            <artifactId>krema-core</artifactId>
            <version>0.3.2</version>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
        </dependency>
        <dependency>
            <groupId>io.vavr</groupId>
            <artifactId>vavr</artifactId>
            <version>1.0.1</version>
        </dependency>
        <!-- JCEF experiment: Chromium Embedded Framework shell (swap for Krema system webview).
             Natives are downloaded automatically on first run (~100 MB per platform). -->
        <dependency>
            <groupId>me.friwi</groupId>
            <artifactId>jcefmaven</artifactId>
            <version>152.0.6</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>25</release>
                    <!-- Krema IPC binds @KremaCommand arguments by parameter name;
                         without this they arrive null with no error. -->
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <!-- Krema launcher. Run with JDK 25 (Maven may default to Temurin 21):
                 JAVA_HOME=/Library/Java/JavaVirtualMachines/jdk-25.jdk/Contents/Home
                     mvn compile exec:exec
                 exec:exec forks ${java.home}/bin/java so the pom JVM flags apply.
                 exec:java is the wrong tool on macOS — it reuses Maven's JVM and
                 drops the flags, so the window never appears. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <!-- ${java.home} is the JDK that Maven itself runs on -->
                    <executable>${java.home}/bin/java</executable>
                    <arguments>
                        <!-- Panama FFM: silence restricted-method warnings -->
                        <argument>--enable-native-access=ALL-UNNAMED</argument>
                        <!-- Heap cap: default max heap is 1/4 of RAM (~2 GB) on this
                             8 GB machine. RSS still includes WebKit. -->
                        <argument>-Xmx512m</argument>
                        <argument>-classpath</argument>
                        <classpath/>
                        <argument>vangogh.app.VanGoghApp</argument>
                    </arguments>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>macos</id>
            <activation>
                <os>
                    <family>mac</family>
                </os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.1.0</version>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <arguments>
                                <!-- macOS: libwebview.dylib drives NSApp (webview_run) on the
                                     calling thread, and AppKit only permits its event loop on
                                     the process's FIRST thread. Without this flag macOS kills
                                     the event loop ("nextEventMatchingMask should only be called
                                     from the Main Thread!") and no window appears. Mirrors
                                     krema-core's own pom. macOS-only HotSpot flag. -->
                                <argument>-XstartOnFirstThread</argument>
                                <argument>--enable-native-access=ALL-UNNAMED</argument>
                                <!-- JCEF macOS requirements (jcefmaven README): harmless for Krema too. -->
                                <argument>--add-opens=java.desktop/sun.awt=ALL-UNNAMED</argument>
                                <argument>--add-opens=java.desktop/sun.lwawt=ALL-UNNAMED</argument>
                                <argument>--add-opens=java.desktop/sun.lwawt.macosx=ALL-UNNAMED</argument>
                                <argument>-Xmx512m</argument>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>vangogh.app.VanGoghApp</argument>
                            </arguments>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- JCEF experiment shell. Run with: mvn exec:exec -Pjcef -->
        <profile>
            <id>jcef</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.1.0</version>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <arguments>
                                <!-- macOS: AppKit requires first thread. -->
                                <argument>-XstartOnFirstThread</argument>
                                <!-- Panama FFM: silence restricted-method warnings. -->
                                <argument>--enable-native-access=ALL-UNNAMED</argument>
                                <!-- JCEF macOS requirements (jcefmaven README). -->
                                <argument>--add-opens=java.desktop/sun.awt=ALL-UNNAMED</argument>
                                <argument>--add-opens=java.desktop/sun.lwawt=ALL-UNNAMED</argument>
                                <argument>--add-opens=java.desktop/sun.lwawt.macosx=ALL-UNNAMED</argument>
                                <!-- Heap cap. -->
                                <argument>-Xmx512m</argument>
                                <argument>-Djava.library.path=/Users/macbookpro/Documents/school-project/van-gogh/jcef-bundle</argument>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>vangogh.app.jcef.JcefVanGoghApp</argument>
                            </arguments>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>