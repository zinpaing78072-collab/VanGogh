# VanGogh LLM settings — example, safe to commit.
#
# Copy this file to the per-user location:
#   macOS/Linux : ~/.van-gogh/llm.conf
#   Windows     : %USERPROFILE%\.van-gogh\llm.conf
#
# Or run the setup script, which writes it for you:
#   macOS/Linux : scripts/setup-llm.sh
#   Windows     : powershell -ExecutionPolicy Bypass -File scripts\setup-llm.ps1
#
# Or open Settings inside the app: it reads and writes this same file. That is
# the only source of truth — environment variables are not consulted.

# Required. Any OpenAI-compatible provider's key.
apiKey = sk-or-v1-...

# Optional — defaults shown.
# baseUrl = https://openrouter.ai/api/v1
# model   = baidu/ernie-5.5-flash-preview:free
# timeoutSeconds = 60
# titles = 10
