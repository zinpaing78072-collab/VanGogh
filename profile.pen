                },
                {
                  "type": "text",
                  "id": "PbE1b",
                  "x": 20,
                  "y": 464,
                  "name": "Overview K",
                  "fill": "#A9B4D6",
                  "content": "OVERVIEW",
                  "fontFamily": "$font-body",
                  "fontSize": 10,
