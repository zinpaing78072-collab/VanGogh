                  "letterSpacing": 1.2
                },
                {
                  "type": "text",
                  "id": "s0UZs",
                  "x": 20,
                  "y": 486,
                  "name": "Overview",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": 428,
                  "content": "Between life and death there is a library, and within it the shelves go on forever. Every book is a chance to try another life you could have lived — Nora Seed's midnight journey between regret and hope, one unread book at a time.",
                  "fontFamily": "$font-body",
                  "fontSize": 11.5,
                  "fontWeight": "normal"
